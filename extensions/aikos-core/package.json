{
  "name": "aikos-ai",
  "displayName": "AIKOS AI — Knowledge OS",
  "description": "Full AI operating system in your editor: multi-agent orchestration, RAG knowledge base, approval workflow, code completion, training pipeline",
  "version": "0.1.0",
  "publisher": "aikos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aikos/ai-studio-rag-db"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "agent",
    "rag",
    "copilot",
    "automation",
    "knowledge",
    "multi-agent",
    "approval",
    "code-completion"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aikos",
          "title": "AIKOS AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aikos": [
        {
          "id": "aikos.chat",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "aikos.tasks",
          "name": "Tasks"
        },
        {
          "id": "aikos.approvals",
          "name": "Approvals"
        },
        {
          "id": "aikos.collections",
          "name": "Collections"
        },
        {
          "id": "aikos.search",
          "name": "Search"
        },
        {
          "id": "aikos.memory",
          "name": "Memory"
        },
        {
          "id": "aikos.unitySessions",
          "name": "Unity Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "aikos.chat.ask",
        "title": "AIKOS: Ask AI",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aikos.chat.explain",
        "title": "AIKOS: Explain Selection"
      },
      {
        "command": "aikos.chat.review",
        "title": "AIKOS: Review Selection"
      },
      {
        "command": "aikos.chat.fix",
        "title": "AIKOS: Fix This"
      },
      {
        "command": "aikos.chat.test",
        "title": "AIKOS: Generate Test"
      },
      {
        "command": "aikos.chat.refactor",
        "title": "AIKOS: Refactor Selection"
      },
      {
        "command": "aikos.search.knowledge",
        "title": "AIKOS: Search Knowledge Base",
        "icon": "$(search)"
      },
      {
        "command": "aikos.task.submit",
        "title": "AIKOS: Submit Task",
        "icon": "$(add)"
      },
      {
        "command": "aikos.task.list",
        "title": "AIKOS: View Tasks"
      },
      {
        "command": "aikos.task.stop",
        "title": "AIKOS: Stop Task"
      },
      {
        "command": "aikos.task.resume",
        "title": "AIKOS: Resume Task"
      },
      {
        "command": "aikos.approval.list",
        "title": "AIKOS: View Approvals"
      },
      {
        "command": "aikos.approval.approve",
        "title": "AIKOS: Approve Action",
        "icon": "$(check)"
      },
      {
        "command": "aikos.approval.reject",
        "title": "AIKOS: Reject Action",
        "icon": "$(close)"
      },
      {
        "command": "aikos.collections.addFile",
        "title": "AIKOS: Add to Collection"
      },
      {
        "command": "aikos.nl2sql",
        "title": "AIKOS: NL-to-SQL Query"
      },
      {
        "command": "aikos.metrics",
        "title": "AIKOS: View Metrics"
      },
      {
        "command": "aikos.settings",
        "title": "AIKOS: Open Settings"
      },
      {
        "command": "aikos.completion.trigger",
        "title": "AIKOS: Trigger Completion"
      },
      {
        "command": "aikos.unity.refresh",
        "title": "AIKOS: Refresh Unity Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "aikos.unity.pin",
        "title": "AIKOS: Pin Unity Session",
        "icon": "$(pin)"
      },
      {
        "command": "aikos.unity.unpin",
        "title": "AIKOS: Unpin Unity Session",
        "icon": "$(pinned)"
      },
      {
        "command": "aikos.unity.focus",
        "title": "AIKOS: Focus Unity Editor"
      },
      {
        "command": "aikos.unity.invokePing",
        "title": "AIKOS: Ping Unity Editor"
      },
      {
        "command": "aikos.unity.openDashboard",
        "title": "AIKOS: Open Unity Dashboard"
      }
    ],
    "keybindings": [
      {
        "command": "aikos.chat.ask",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "aikos.chat.explain",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorHasSelection"
      },
      {
        "command": "aikos.search.knowledge",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "aikos.task.submit",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      },
      {
        "command": "aikos.chat.fix",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorHasSelection"
      },
      {
        "command": "aikos.chat.review",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorHasSelection"
      },
      {
        "command": "aikos.nl2sql",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aikos.chat.explain",
          "group": "aikos@1",
          "when": "editorHasSelection"
        },
        {
          "command": "aikos.chat.review",
          "group": "aikos@2",
          "when": "editorHasSelection"
        },
        {
          "command": "aikos.chat.fix",
          "group": "aikos@3",
          "when": "editorHasSelection"
        },
        {
          "command": "aikos.chat.test",
          "group": "aikos@4",
          "when": "editorHasSelection"
        },
        {
          "command": "aikos.chat.refactor",
          "group": "aikos@5",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "aikos.collections.addFile",
          "group": "aikos@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aikos.task.stop",
          "when": "view == aikos.tasks && viewItem == running",
          "group": "inline"
        },
        {
          "command": "aikos.task.resume",
          "when": "view == aikos.tasks && viewItem == paused",
          "group": "inline"
        },
        {
          "command": "aikos.approval.approve",
          "when": "view == aikos.approvals && viewItem == pending",
          "group": "inline@1"
        },
        {
          "command": "aikos.approval.reject",
          "when": "view == aikos.approvals && viewItem == pending",
          "group": "inline@2"
        },
        {
          "command": "aikos.unity.pin",
          "when": "view == aikos.unitySessions && viewItem == unity-session",
          "group": "inline@1"
        },
        {
          "command": "aikos.unity.unpin",
          "when": "view == aikos.unitySessions && viewItem == unity-session-pinned",
          "group": "inline@1"
        },
        {
          "command": "aikos.unity.invokePing",
          "when": "view == aikos.unitySessions",
          "group": "1_actions@1"
        },
        {
          "command": "aikos.unity.focus",
          "when": "view == aikos.unitySessions",
          "group": "1_actions@2"
        }
      ],
      "view/title": [
        {
          "command": "aikos.unity.refresh",
          "when": "view == aikos.unitySessions",
          "group": "navigation@1"
        },
        {
          "command": "aikos.unity.openDashboard",
          "when": "view == aikos.unitySessions",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "AIKOS AI",
      "properties": {
        "aikos.apiUrl": {
          "type": "string",
          "default": "http://localhost:3001/api/v1",
          "description": "AIKOS API base URL"
        },
        "aikos.agentServiceUrl": {
          "type": "string",
          "default": "http://localhost:8100",
          "description": "Agent Service base URL"
        },
        "aikos.defaultCollection": {
          "type": "string",
          "default": "",
          "description": "Default collection ID for RAG queries"
        },
        "aikos.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default LLM model ID"
        },
        "aikos.enableCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline code completion (ghost text)"
        },
        "aikos.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens actions (Explain, Test, Review) on functions"
        },
        "aikos.enableDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI-powered diagnostics on save (experimental)"
        },
        "aikos.completionDebounce": {
          "type": "number",
          "default": 500,
          "minimum": 200,
          "maximum": 2000,
          "description": "Debounce delay for code completions (ms)"
        },
        "aikos.maxContextTokens": {
          "type": "number",
          "default": 4000,
          "minimum": 1000,
          "maximum": 16000,
          "description": "Maximum RAG context tokens for completions"
        },
        "aikos.autoApprove.safe": {
          "type": "boolean",
          "default": true,
          "description": "Auto-approve SAFE risk level actions"
        },
        "aikos.autoApprove.low": {
          "type": "boolean",
          "default": true,
          "description": "Auto-approve LOW risk level actions"
        },
        "aikos.notifications.approval": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code notifications for pending approvals"
        },
        "aikos.language": {
          "type": "string",
          "enum": ["en", "vi"],
          "default": "en",
          "description": "Extension UI language"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "aikos.setup",
        "title": "Get Started with AIKOS AI",
        "description": "Set up your AI Knowledge OS integration in VS Code",
        "steps": [
          {
            "id": "apiKey",
            "title": "Set your API key",
            "description": "Run **AIKOS: Open Settings** from the Command Palette to enter your API key.",
            "media": {
              "markdown": "media/walkthrough/api-key.md"
            },
            "completionEvents": [
              "onCommand:aikos.settings"
            ]
          },
          {
            "id": "collection",
            "title": "Select a default collection",
            "description": "Choose a collection for RAG-augmented queries in AIKOS settings.",
            "media": {
              "markdown": "media/walkthrough/collection.md"
            }
          },
          {
            "id": "firstChat",
            "title": "Ask your first question",
            "description": "Press **Ctrl+Shift+A** to open the chat panel and ask a question.",
            "media": {
              "markdown": "media/walkthrough/chat.md"
            },
            "completionEvents": [
              "onCommand:aikos.chat.ask"
            ]
          },
          {
            "id": "firstTask",
            "title": "Submit your first agent task",
            "description": "Press **Ctrl+Shift+T** to submit a task for the multi-agent pipeline.",
            "media": {
              "markdown": "media/walkthrough/task.md"
            },
            "completionEvents": [
              "onCommand:aikos.task.submit"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src/",
    "test": "mocha --require ts-node/register 'test/unit/**/*.test.ts'",
    "test:e2e": "node ./test/run-tests.js",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "mocha": "^11.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.0"
  }
}
